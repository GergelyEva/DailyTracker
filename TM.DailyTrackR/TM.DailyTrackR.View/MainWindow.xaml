<Window x:Class="TM.DailyTrackR.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TM Daily TrackR" Height="450" Width="800"
        Background="LightGray">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="ActivitiesTextStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="DarkGreen"/>
        </Style>
        <Style TargetType="Button" x:Key="GreenButtonStyle">
            <Setter Property="Background" Value="DarkGreen"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Calendar x:Name="calendar" Grid.Column="0" Margin="10" DisplayDate="2024-06-13" SelectedDate="2024-06-13"/>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl>
                <TabItem Header="Daily">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource ActivitiesTextStyle}">
                            <Run Text="Activities Date: "/>
                            <Run Text="{Binding ElementName=calendar, Path=SelectedDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                        </TextBlock>

                        <Button x:Name="addButton" Content="Add" Width="50" Height="35" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="AddButtonClick"
                                Style="{StaticResource GreenButtonStyle}"/>

                        <DataGrid x:Name="dailyDataGrid" CanUserAddRows="False"   Grid.Row="1" Margin="10" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single" ItemsSource="{Binding Activities}" CurrentCellChanged="DailyDataGrid_CurrentCellChanged" >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No." Binding="{Binding No}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Project type" Binding="{Binding ProjectType}" Width="100"/>
                                <DataGridTextColumn Header="Task type" Binding="{Binding TaskType}" Width="70"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="70" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Delete" Click="DeleteMenuItemClick"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Overview">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource ActivitiesTextStyle}">
                            <Run Text="Activities Date: "/>
                            <Run Text="{Binding ElementName=calendar, Path=SelectedDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                        </TextBlock>

                        <TextBlock Grid.Row="0" Text="{Binding Username}" Style="{StaticResource ActivitiesTextStyle}" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                        <DataGrid x:Name="overviewDataGrid" CanUserAddRows="False"  Grid.Row="1" Margin="10" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single" ItemsSource="{Binding Activities}" IsReadOnly="true">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No." Binding="{Binding No}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Project type" Binding="{Binding ProjectType}" Width="100"/>
                                <DataGridTextColumn Header="Task type" Binding="{Binding TaskType}" Width="70"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="70" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Delete" Click="DeleteMenuItemClick"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10">
                            <TextBlock Text="Export activity in" VerticalAlignment="Center" Foreground="DarkGreen"/>
                            <DatePicker x:Name="startDatePicker" Margin="5,0"/>
                            <TextBlock Text="to" VerticalAlignment="Center" Foreground="DarkGreen"/>
                            <DatePicker x:Name="endDatePicker" Margin="5,0"/>
                            <Button Content="Export CSV" Click="ExportButton_Click" Margin="5,0" Style="{StaticResource GreenButtonStyle}"/>
                            <Button Content="Export to Excel" Click="ExportToExcelButton_Click" Margin="5,0" Style="{StaticResource GreenButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
